# OpenAI API anahtarını buraya yazma; gerçek .env dosyası yerel kalmalıdır.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=minimal
MAX_OUTPUT_TOKENS=1200

# Tahmini ücret hesabı için modelin 1M token fiyatları (USD). Boşsa maliyet yazılmaz.
OPENAI_INPUT_PRICE_PER_1M=
OPENAI_OUTPUT_PRICE_PER_1M=
# Kullanım kaydının yazılacağı dosya (varsayılan: usage_log.jsonl)
USAGE_LOG_PATH=

SCAN_COUNT=30
MAX_SUMMARIES=5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
